# ForgePanel on a platform edge — every one of these is optional.
#
# The platform supplies what matters: PORT (which port to bind) and its own
# hostname variable. The panel reads those on every start, so the settings that
# would matter on a server it owns — panel port, TLS, ACME — are not choices here.

# A custom domain attached at the platform's edge. Overrides the generated
# *.up.railway.app hostname in every link the panel writes.
# FORGEPANEL_DOMAIN=vpn.example.com

# First administrator's username. Default: admin.
# FORGEPANEL_ADMIN_USER=admin

# Telegram bot credentials. Both are also settable inside the panel.
# FORGEPANEL_TELEGRAM_TOKEN=
# FORGEPANEL_TELEGRAM_ADMINS=

# Platform mode. Detected automatically on Railway, Render, Fly and Koyeb.
# Set to 1 to force it on behind any other TLS-terminating edge; 0 to force it
# off and have the panel manage its own TLS.
# FORGEPANEL_PAAS=1

# Where the panel keeps its database, secrets and certificates. The image sets
# this, and it is the path a platform volume must be mounted at — without one,
# every deploy starts from an empty panel.
# FORGEPANEL_DATA=/var/lib/forgepanel
